---
import Layout from '../layouts/Layout.astro';
---

<Layout
	lang="en"
	title="Page not found | Henry Xitimul"
	description="The requested page could not be found. Return to Henry Xitimul’s portfolio in English or Spanish."
	path="/404/"
	robots="noindex, follow"
	canonical={false}
	structuredData={false}
>
	<div class="flex min-h-screen flex-col bg-page text-ink">
		<header class="border-b border-line bg-page/90">
			<div class="mx-auto flex h-18 w-full max-w-7xl items-center px-5 sm:px-8 lg:px-10">
				<a href="/" class="whitespace-nowrap text-lg font-extrabold tracking-tight text-ink focus-visible:rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand">
					Henry <span class="text-brand">Xitimul</span>
				</a>
			</div>
		</header>
		<main class="grid grow place-items-center px-5 py-16">
			<section class="w-full max-w-2xl rounded-3xl border border-line bg-panel p-8 text-center shadow-card sm:p-12">
				<p class="text-sm font-extrabold uppercase tracking-[0.25em] text-success">404</p>
				<h1 class="mt-4 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">Page not found</h1>
				<p class="mx-auto mt-5 max-w-lg text-base leading-7 text-muted">The page may have moved or the address may be incorrect.</p>
				<p lang="es" class="mx-auto mt-2 max-w-lg text-sm leading-6 text-muted">La página puede haberse movido o la dirección podría ser incorrecta.</p>
				<div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
					<a href="/" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-brand px-6 py-3 text-sm font-bold text-white transition hover:bg-brand-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-page dark:text-page">Return to English portfolio</a>
					<a href="/es/" hreflang="es" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-line bg-raised px-6 py-3 text-sm font-bold text-ink transition hover:border-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-page">Volver al portfolio en español</a>
				</div>
			</section>
		</main>
	</div>
</Layout>
